PUBLIC_PROTOMAPS_KEY=your_protomaps_public_key
# Optional: serve data artifacts from a local copy instead of R2 during development
# PUBLIC_DATA_BASE=/dev-data

# Mapbox public token (pk.*) for place search; URL-restrict it in the Mapbox account
# PUBLIC_MAPBOX_TOKEN=pk.your_public_token

# Cloudflare Turnstile site key for the feedback form; the form is hidden when unset.
# 1x00000000000000000000AA is Cloudflare's always-passing test key for local testing.
# PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
